# Flask environment: development | testing | production
APP_ENV=development

# Used to sign session data. Change this in production.
SECRET_KEY=change-me-to-a-random-secret

# Used to sign JWT access/refresh tokens. Change this in production.
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# SQLite for local dev (default). For Docker/production, use PostgreSQL, e.g.:
# postgresql://taskflow:taskflow@db:5432/taskflow
DATABASE_URL=sqlite:///taskflow.db

# Rate limiting (Flask-Limiter). Use redis://host:6379 in production for a
# shared store across multiple app instances; memory:// is fine for local dev.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=100 per minute
RATELIMIT_ENABLED=true

PORT=5000
